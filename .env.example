# Backend configuration (environment variables only; never commit .env). No API keys are required.
THREATLENS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# THREATLENS_ALLOWED_ORIGIN_REGEX=https://.*--your-site\.netlify\.app
# THREATLENS_DB=data/cases.db
# THREATLENS_MODEL_DIR=models
# THREATLENS_RESULTS_DIR=experiments/results
# THREATLENS_TI_SNAPSHOT=data/cti_snapshot.csv     # default is the DEMO snapshot
# THREATLENS_ALLOW_SYNTHETIC_MODEL=true             # set false in production
# THREATLENS_ALLOW_RAW_STORAGE=true                 # set false in production
# THREATLENS_INCIDENTS_ENABLED=true
# THREATLENS_INCIDENT_TOKEN=                        # if set, incident endpoints need header X-ThreatLens-Token
